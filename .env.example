# Copy this file to .env for local development.
# Values here are for running on your own machine. docker-compose.yml sets
# the container values (Docker volume paths, host.docker.internal) itself.

# true = run without Ollama (the LLM returns fixed mock values)
MOCK_LLM=false

# ollama | cloud (cloud is a fallback only and must be disclosed in the README)
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=120

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_MAX_TOKENS=256
FETCH_K=20
TOP_K=3
MIN_SCORE=0.5

# Local stores (both folders are git-ignored)
CHROMA_PATH=./data/chroma
SQLITE_PATH=./data/sqlite/app.db
UPLOADS_DIR=./data/uploads
